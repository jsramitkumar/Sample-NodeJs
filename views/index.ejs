<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Server Info Dashboard</title>
  <link href="/styles.css" rel="stylesheet">
  <script>
    // Data arrays for chart
    const cpuData = [];
    const memoryData = [];
    const timeLabels = [];
    let chart;
    
    // Function to update the time dynamically
    function updateTime() {
      const now = new Date();
      const options = { 
        weekday: 'long', 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
      };
      document.getElementById('time').textContent = now.toLocaleString(undefined, options);
    }
    
    // Function to fetch server metrics
    async function fetchServerMetrics() {
      try {
        const response = await fetch('/metrics');
        const data = await response.json();
        
        // Update displayed metrics
        document.getElementById('cpu-usage').textContent = `${data.cpuUsage}%`;
        document.getElementById('memory-usage').textContent = `${data.memoryUsage}%`;
        document.getElementById('free-memory').textContent = `${data.freeMemory} GB`;
        document.getElementById('process-memory').textContent = `${data.processMemory} MB`;
        
        // Add new data points to arrays
        const now = new Date();
        const timeLabel = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        
        cpuData.push(data.cpuUsage);
        memoryData.push(data.memoryUsage);
        timeLabels.push(timeLabel);
        
        // Keep only last 20 data points
        if (cpuData.length > 20) {
          cpuData.shift();
          memoryData.shift();
          timeLabels.shift();
        }
        
        // Update chart
        chart.data.labels = timeLabels;
        chart.data.datasets[0].data = cpuData;
        chart.data.datasets[1].data = memoryData;
        chart.update();
        
        // Update progress bars
        document.getElementById('cpu-progress').style.width = `${data.cpuUsage}%`;
        document.getElementById('memory-progress').style.width = `${data.memoryUsage}%`;
      } catch (error) {
        console.error('Failed to fetch metrics:', error);
      }
    }
    
    // Initialize chart when DOM content is loaded
    document.addEventListener('DOMContentLoaded', () => {
      updateTime();
      
      // Initialize chart
      const ctx = document.getElementById('performance-chart').getContext('2d');
      chart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: timeLabels,
          datasets: [
            {
              label: 'CPU Usage (%)',
              data: cpuData,
              borderColor: 'rgba(59, 130, 246, 1)', // blue-500
              backgroundColor: 'rgba(59, 130, 246, 0.1)',
              borderWidth: 2,
              tension: 0.4,
              fill: true
            },
            {
              label: 'Memory Usage (%)',
              data: memoryData,
              borderColor: 'rgba(79, 70, 229, 1)', // indigo-600
              backgroundColor: 'rgba(79, 70, 229, 0.1)',
              borderWidth: 2,
              tension: 0.4,
              fill: true
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: 'index',
            intersect: false,
          },
          scales: {
            y: {
              min: 0,
              max: 100,
              ticks: {
                callback: (value) => `${value}%`
              }
            }
          },
          plugins: {
            legend: {
              position: 'top',
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return `${context.dataset.label}: ${context.raw}%`;
                }
              }
            }
          }
        }
      });
      
      // Fetch metrics immediately and then every 2 seconds
      fetchServerMetrics();
      setInterval(fetchServerMetrics, 2000);
      
      // Update time every second
      setInterval(updateTime, 1000);
    });
  </script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
</head>
<body class="bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen flex items-center justify-center p-4">
  <div class="max-w-4xl w-full bg-white rounded-xl shadow-xl overflow-hidden">
    <!-- Header -->
    <div class="bg-gradient-to-r from-blue-600 to-indigo-600 p-6 text-white">
      <h1 class="text-3xl md:text-4xl font-bold text-center">Server Dashboard</h1>
      <p class="text-blue-100 text-center mt-2">Real-time server information</p>
    </div>
    
    <!-- Content -->
    <div class="p-6 md:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left Column - Server Info -->
        <div class="lg:col-span-1 space-y-6">
          <!-- Server Hostname Card -->
          <div class="bg-gray-50 rounded-lg p-4 shadow-sm border border-gray-100 transition-all hover:shadow-md">
            <div class="flex items-center mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2H5z" />
              </svg>
              <h2 class="text-lg font-semibold text-gray-800">Server Hostname</h2>
            </div>
            <div class="bg-white rounded-md p-3 border border-gray-200">
              <p class="text-xl font-mono text-indigo-700 break-all"><%= serverInfo.hostname %></p>
            </div>
          </div>
          
          <!-- Local Time Card -->
          <div class="bg-gray-50 rounded-lg p-4 shadow-sm border border-gray-100 transition-all hover:shadow-md">
            <div class="flex items-center mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <h2 class="text-lg font-semibold text-gray-800">Local Time</h2>
            </div>
            <div class="bg-white rounded-md p-3 border border-gray-200">
              <p id="time" class="text-xl font-mono text-indigo-700"></p>
            </div>
          </div>
          
          <!-- System Info Card -->
          <div class="bg-gray-50 rounded-lg p-4 shadow-sm border border-gray-100 transition-all hover:shadow-md">
            <div class="flex items-center mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
              <h2 class="text-lg font-semibold text-gray-800">System Info</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
              <div class="bg-white rounded-md p-2 border border-gray-200">
                <p class="text-sm text-gray-500">Platform</p>
                <p class="font-mono text-indigo-600"><%= serverInfo.platform %></p>
              </div>
              <div class="bg-white rounded-md p-2 border border-gray-200">
                <p class="text-sm text-gray-500">Architecture</p>
                <p class="font-mono text-indigo-600"><%= serverInfo.arch %></p>
              </div>
              <div class="bg-white rounded-md p-2 border border-gray-200">
                <p class="text-sm text-gray-500">Up Time</p>
                <p class="font-mono text-indigo-600"><%= serverInfo.uptime %> hours</p>
              </div>
              <div class="bg-white rounded-md p-2 border border-gray-200">
                <p class="text-sm text-gray-500">Memory</p>
                <p class="font-mono text-indigo-600"><%= serverInfo.memory %> GB</p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Right Column - Performance Monitoring -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Performance Chart Card -->
          <div class="bg-gray-50 rounded-lg p-4 shadow-sm border border-gray-100 transition-all hover:shadow-md">
            <div class="flex items-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
              <h2 class="text-lg font-semibold text-gray-800">Performance Monitor</h2>
            </div>
            <div class="bg-white rounded-md p-3 border border-gray-200">
              <div class="h-64">
                <canvas id="performance-chart"></canvas>
              </div>
            </div>
          </div>
          
          <!-- Current Metrics Card -->
          <div class="bg-gray-50 rounded-lg p-4 shadow-sm border border-gray-100 transition-all hover:shadow-md">
            <div class="flex items-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" />
              </svg>
              <h2 class="text-lg font-semibold text-gray-800">Current Resource Usage</h2>
            </div>
            <div class="space-y-4">
              <!-- CPU Usage -->
              <div>
                <div class="flex justify-between mb-1">
                  <span class="text-sm font-medium text-gray-700">CPU Usage</span>
                  <span id="cpu-usage" class="text-sm font-medium text-blue-600">0%</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2.5">
                  <div id="cpu-progress" class="bg-blue-600 h-2.5 rounded-full" style="width: 0%"></div>
                </div>
              </div>
              
              <!-- Memory Usage -->
              <div>
                <div class="flex justify-between mb-1">
                  <span class="text-sm font-medium text-gray-700">Memory Usage</span>
                  <span id="memory-usage" class="text-sm font-medium text-indigo-600">0%</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2.5">
                  <div id="memory-progress" class="bg-indigo-600 h-2.5 rounded-full" style="width: 0%"></div>
                </div>
              </div>
              
              <!-- Additional Metrics -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-2 pt-2">
                <div class="bg-gray-100 rounded-md p-2">
                  <p class="text-sm text-gray-500">Free Memory</p>
                  <p id="free-memory" class="font-mono text-blue-600">0 GB</p>
                </div>
                <div class="bg-gray-100 rounded-md p-2">
                  <p class="text-sm text-gray-500">Process Memory</p>
                  <p id="process-memory" class="font-mono text-indigo-600">0 MB</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Footer -->
    <div class="bg-gray-50 py-4 px-6 border-t border-gray-100">
      <p class="text-center text-gray-500 text-sm">
        Running on <span class="font-semibold">MiniRPi4</span> on Kubernetes Cluster.
      </p>
    </div>
  </div>
</body>
</html>